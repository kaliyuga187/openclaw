# ----------------------------------------------------------------------------
# OpenClaw — environment variables
# Copy to .env.local for development. NEVER commit a populated .env file.
# ----------------------------------------------------------------------------

# Node environment: development | production | test
NODE_ENV=development

# Public app URL (used by NextAuth, Stripe redirects, emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Database ---------------------------------------------------------------
# Postgres connection string. For local dev with docker-compose, use:
#   postgresql://gsd:gsd@localhost:5432/gsd?schema=public
DATABASE_URL=postgresql://gsd:gsd@localhost:5432/gsd?schema=public

# ---- Auth (NextAuth) --------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional Google OAuth — leave blank to disable the Google sign-in button
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Stripe -----------------------------------------------------------------
# Server-side secret key (sk_test_... or sk_live_...). REQUIRED for invoicing.
STRIPE_SECRET_KEY=
# Webhook signing secret from `stripe listen` or the dashboard
STRIPE_WEBHOOK_SECRET=
# Currency for new invoices (ISO 4217)
STRIPE_DEFAULT_CURRENCY=usd

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=info

# ---- Rate limiting ----------------------------------------------------------
# Requests per minute per IP for sensitive endpoints (login, register, webhook)
RATE_LIMIT_PER_MINUTE=20
