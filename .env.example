# Copy to .env and fill with your Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Must be a WhatsApp-enabled Twilio number, prefixed with whatsapp:
TWILIO_WHATSAPP_FROM=whatsapp:+17343367101

# Claude Flow (multi-agent orchestration) — optional
CLAUDE_FLOW_LOG_LEVEL=info
CLAUDE_FLOW_MEMORY_BACKEND=hybrid
CLAUDE_FLOW_MEMORY_PATH=./data/claude-flow/memory

# Polymarket trading bot (src/polymarket) — all optional.
# Dry-run is ON by default. The bot will NOT place real orders unless you
# explicitly set POLYMARKET_DRY_RUN=false AND supply a funded private key.
POLYMARKET_DRY_RUN=true
POLYMARKET_TRADE_SIZE_USD=20
POLYMARKET_MAX_TRADES=10
POLYMARKET_MAX_OPEN_POSITIONS=5
POLYMARKET_MIN_WIN_RATE=0.6
POLYMARKET_MIN_PNL_USD=5000
POLYMARKET_MIN_TRADE_COUNT=20
POLYMARKET_MIN_CONFIDENCE=0.6
# Required only when POLYMARKET_DRY_RUN=false. 0x-prefixed 32-byte hex.
# POLYMARKET_PRIVATE_KEY=
# Optional funder/proxy override for Polymarket signature type 1.
# POLYMARKET_FUNDER=
# API endpoints (override only for testing).
# POLYMARKET_CLOB_URL=https://clob.polymarket.com
# POLYMARKET_DATA_URL=https://data-api.polymarket.com
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
